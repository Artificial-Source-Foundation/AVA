	path = cmake/aicxx
	url = https://github.com/CarloWood/cmake-aicxx.git
	update = checkout
[submodule "utils"]
	path = utils
	url = https://github.com/RichForget/ai-utils.git
	update = checkout
	branch = apple-silicon-portability
[submodule "enchantum"]
	path = enchantum
	url = https://github.com/ZXShady/enchantum.git
	update = checkout
[submodule "src/json"]
	path = src/json
	url = https://github.com/nlohmann/json.git
	update = checkout
[submodule "threadsafe"]
	path = threadsafe
	url = https://github.com/CarloWood/threadsafe.git
	update = checkout
[submodule "memory"]
	path = memory
	url = https://github.com/RichForget/memory.git
	update = checkout
	branch = apple-silicon-portability
