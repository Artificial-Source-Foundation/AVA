unset configure
unset make

export BUILDDIR=$REPOROOT/cpp/build
export CTAGS_FILE=$BUILDDIR/tags

function configure() { cmake . -B ../build -DCMAKE_VERBOSE_MAKEFILE=ON; }

make_impl() (
  case $1 in
    ctags | tags)
      CTAGS_LANGUAGES=c++
      create_ctags_file
    ;;
    install)
      echo "Nothing to install."
    ;;
    *)
      /usr/bin/make -C $REPOROOT/cpp/build
    ;;
  esac;
)

function make() {
  make_impl "$@"
}

alias vi='vim -c "set tags=$BUILDDIR/tags"'

alias-ncurses-tests() {
  local file base exe

  shopt -s nullglob

  for file in "$REPOROOT"/cpp/ncurses-tests/linux[0-9][0-9]-*.cpp; do
    base="${file##*/}"       # linux00-whatever.cpp
    exe="${base%%-*}"        # linux00

    alias "$exe=$BUILDDIR/$exe"
  done
}

alias-ncurses-tests
